# /etc/cron.d/plato — see docs/02-features/cron-jobs.md
# Rendered by deploy/bootstrap.sh; do not edit this file directly — edit
# the source at deploy/plato.cron and re-run bootstrap.
#
# All jobs run as root. The bin/*.js scripts re-drop privilege via
# `sudo -u plato` where they touch plato data; root is needed for
# system-level work (sendmail, certbot file access).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
MAILTO=${ADMIN_EMAIL}
# Cron job-failure mail comes from the forum's own domain, not root@<hostname>
# (honored by cronie; ignored harmlessly by crons that don't support MAILFROM).
MAILFROM=noreply@${DOMAIN}

# Monitoring is pulselog (the external watcher). Its config is generated from
# config.json by `npm run gen-pulselog` — run that once before installing these.
# To disable monitoring entirely, set operator.monitoring=false and drop the
# three pulselog lines below.

# Hourly: URLhaus malicious-URL feed
0 * * * *           root cd ${INSTALL_DIR} && sudo -u plato node bin/refresh-urlhaus.js >> /var/log/plato-urlhaus.log 2>&1

# pulselog backup: daily 03:30 UTC (forum.db + knowless.db + posts/), 7 newest kept.
30 3 * * *          root cd ${INSTALL_DIR} && sudo -u plato node_modules/.bin/pulselog --backup --config pulselog.config.json >> /var/log/plato-backup.log 2>&1

# Daily 04:15 UTC: TLS cert expiry check (graduated severity). Slow-moving, so it
# stays daily here rather than in pulselog's 5-min health run.
15 4 * * *          root cd ${INSTALL_DIR} && DOMAIN=${DOMAIN} BACKUP_DIR=${BACKUP_DIR} bin/check-cert.sh >> /var/log/plato-cert.log 2>&1

# Daily 05:15 UTC: sub inactivity sweep
15 5 * * *          root cd ${INSTALL_DIR} && sudo -u plato node bin/check-sub-inactivity.js >> /var/log/plato-inactivity.log 2>&1

# pulselog digest: weekly Mon 06:00 UTC, stats (via bin/stats.js --metrics-json)
# + flightlog error rollup, emailed to operator.email.
0 6 * * 1           root cd ${INSTALL_DIR} && sudo -u plato node_modules/.bin/pulselog --digest --config pulselog.config.json >> /var/log/plato-stats.log 2>&1

# Quarterly: disposable-domains refresh
0 6 1 1,4,7,10 *    root ${INSTALL_DIR}/scripts/cron-refresh-disposable.sh

# Every 15 min: archive export queue (off-peak window enforced inside script)
*/15 * * * *        root cd ${INSTALL_DIR} && sudo -u plato node bin/run-export-queue.js >> /var/log/plato-export.log 2>&1

# Every 15 min: archive import queue
*/15 * * * *        root cd ${INSTALL_DIR} && sudo -u plato node bin/run-import-queue.js >> /var/log/plato-import.log 2>&1

# pulselog health: every 5 min — probes localhost /healthz, disk, backup
# freshness, plato.service. Silent on green, one email on break. Runs as plato
# (config is plato-owned; systemctl is-active is a non-root read).
*/5 * * * *         root cd ${INSTALL_DIR} && sudo -u plato node_modules/.bin/pulselog --config pulselog.config.json >> /var/log/plato-health.log 2>&1
